{
  "name": "immortality",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node server.js",
    "game:dev": "bun run --cwd apps/game-server dev",
    "game:start": "bun run --cwd apps/game-server start",
    "game:smoke": "bun run --cwd apps/game-server smoke",
    "game:smoke:redis-failure": "bun run --cwd apps/game-server smoke:redis-failure",
    "game:smoke:redis-multi": "bun run --cwd apps/game-server smoke:redis-multi",
    "game:load:basic": "bun run --cwd apps/game-server load:basic",
    "game:load:map-shards": "bun run --cwd apps/game-server load:map-shards",
    "game:load:map-move": "bun run --cwd apps/game-server load:map-move",
    "game:load:repair": "bun run --cwd apps/game-server load:repair",
    "game:load:reconnect": "bun run --cwd apps/game-server load:reconnect",
    "game:load:combat-command": "bun run --cwd apps/game-server load:combat-command",
    "game:load:boss-command": "bun run --cwd apps/game-server load:boss-command",
    "game:load:pvp-command": "bun run --cwd apps/game-server load:pvp-command",
    "game:load:settlement-intent": "bun run --cwd apps/game-server load:settlement-intent",
    "game:load:stage10-local": "bun run --cwd apps/game-server load:stage10-local",
    "game:load:stage10-scale-local": "bun run --cwd apps/game-server load:stage10-scale-local",
    "lint": "eslint",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "android:sync": "bun run cap:sync",
    "android:open": "bun run cap:open:android",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:setup": "bun run db:generate && bun run db:migrate",
    "db:cleanup:temporary-secret-realms": "bun run scripts/cleanup-secret-realm-runtime.ts",
    "db:seed:starter-fortunes": "bun run src/db/scripts/seed-starter-fortunes.ts",
    "db:seed:buff-skills": "bun run src/db/scripts/seed-buff-skills.ts",
    "worldpack:four-realms:export": "bun run scripts/export-four-realms-pack.ts",
    "worldpack:four-realms:validate": "bun run scripts/validate-four-realms-pack.ts",
    "worldpack:four-realms:sync-icons": "bun run scripts/sync-four-realms-icons.ts",
    "worldpack:four-realms:prune-legacy": "bun run scripts/prune-four-realms-legacy-data.ts",
    "worldpack:four-realms:apply": "bun run scripts/apply-four-realms-pack.ts",
    "worldpack:four-realms:deploy": "bun run scripts/deploy-four-realms-reset.ts",
    "worldpack:four-realms:bundle-apply": "bun build ./scripts/apply-four-realms-pack.ts --target node --outfile ./docker/four-realms-apply.mjs",
    "worldpack:ai-cosmetics:prepare": "bun run scripts/prepare-ai-cosmetic-library.ts",
    "smoke:local-multi-account": "bun run scripts/local-multi-account-smoke.ts",
    "db:migrate:plugin-legacy-data": "bun run scripts/migrate-plugin-legacy-data.ts",
    "stage6:combat-command:check": "bun run scripts/audit-stage6-combat-colyseus-command.ts",
    "stage6:combat-command:audit": "bun run scripts/audit-stage6-combat-colyseus-command.ts",
    "stage6:combat-mainline:audit": "bun run scripts/audit-stage6-combat-mainline-cutover.ts",
    "stage6:combat-mainline:check": "bun run scripts/audit-stage6-combat-mainline-cutover.ts --strict",
    "legacy-plugin-gameplay:audit": "bun run scripts/audit-legacy-plugin-gameplay-core-migration.ts",
    "legacy-plugin-gameplay:check": "bun run scripts/audit-legacy-plugin-gameplay-core-migration.ts --strict",
    "core-crafting-gongfa:schema:audit": "bun run scripts/audit-core-crafting-gongfa-schema.ts",
    "core-crafting-gongfa:schema:check": "bun run scripts/audit-core-crafting-gongfa-schema.ts --strict",
    "stage9:realtime:audit": "bun run scripts/audit-stage9-realtime-preconditions.ts",
    "stage9:realtime:check": "bun run scripts/audit-stage9-realtime-preconditions.ts --strict",
    "stage-p1b:h5-mainline:audit": "bun run scripts/audit-p1b-h5-mainline-cutover.ts",
    "stage-p1b:h5-mainline:check": "bun run scripts/audit-p1b-h5-mainline-cutover.ts --strict",
    "stage-p2:social-sse:audit": "bun run scripts/audit-chat-notification-sse-dependencies.ts",
    "stage-p2:social-sse:check": "bun run scripts/audit-chat-notification-sse-dependencies.ts --strict",
    "game-server:address:audit": "bun run scripts/audit-game-server-public-address.ts",
    "game-server:address:check": "bun run scripts/audit-game-server-public-address.ts --strict",
    "game-server:health-url:check": "bun run scripts/check-game-server-health-url-resolution.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.0",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/plots": "^2.6.8",
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@colyseus/core": "0.17.44",
    "@colyseus/redis-driver": "^0.17.7",
    "@colyseus/redis-presence": "^0.17.7",
    "@colyseus/schema": "^4.0.27",
    "@colyseus/sdk": "^0.17.43",
    "@msgpack/msgpack": "^3.1.3",
    "antd": "^6.3.0",
    "colyseus": "^0.17.10",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "openai": "^6.21.0",
    "phaser": "^4.2.0",
    "postgres": "^3.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@types/bun": "^1.3.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fflate": "^0.8.2",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
